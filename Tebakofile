    linux-gnu-x86_64:
      tebako:    "5e4683b261e4942e13b71277d6f7041677678dc01dd98cc92f3b06e7dca25a0e"
      tfs:    "cbc6f3e483b19c2293abf66eda63646b492bf46b645dda1b9a564e4f710c1387"
