# Suite recipe for hello-runtimes — one hello-world app payload per
# tebako runtime. This repo is deliberately a SUITE: one repo, one
# release, N payloads (the per-runtime samples share a version line).
# The one-repo-per-package convention bends here by design — this is the
# reference the docs walk through.
name: hello-runtimes
version: "1.0.11"               # every payload in the suite versions together

# The pinned tebako toolchain (tfs mkimage + tebako check/publish),
# digest-pinned per platform against the release's own SHA256SUMS (the
# trust-anchor pattern: a drifted byte is a pin mismatch, named).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.60"           # v2.8.60 makes an image's symlink entry
                               # readable through the C ABI (spec 11 §9:
                               # lstat reports it, readlink returns the
                               # target, stat/open follow through the mount
                               # router, ELOOP past 32 hops) and lets a
                               # re-press reuse the cached runtime layout.
                               # The suite's payloads carry no links, so the
                               # pins move for the line's currency; it rides
                               # v2.8.59's press default + solver, v2.8.58's
                               # shipped blksum sidecars, and v2.8.55's
                               # host-gated lazy wire (tebako#853)
  sha256:
    linux-gnu-x86_64:
      tebako:    "7be77815a3b8077814e01029ee6cb44cec9a0ba9f51b54b7a4ec7a097b3de7ec"
