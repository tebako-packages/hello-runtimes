    linux-gnu-x86_64:
      tebako:    "3599cdadcff89ab590385dec73227e01fd6dd3953723c0d86ffa443844ebbbeb"
      tfs:    "9200cc0e6cd0773efd31b625ddaa38cac52aeb6e6ee1c8d94f146b64f396f587"
      shim:    "11c91f803aeeb19812005cbaad7b1a69e1eaeea25fe79a03ee3556c17c43405d"
      pkg:    "68391003fd3149630dd5141e76a0176de84bccbc96bf45e7379d561dab395949"
