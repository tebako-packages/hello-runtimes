# Suite recipe for hello-runtimes — one hello-world app payload per
# tebako runtime. This repo is deliberately a SUITE: one repo, one
# release, N payloads (the per-runtime samples share a version line).
# The one-repo-per-package convention bends here by design — this is the
# reference the docs walk through.
name: hello-runtimes
version: "1.0.11"               # every payload in the suite versions together

# The pinned tebako toolchain (tfs mkimage + tebako check/publish),
# digest-pinned per platform against the release's own SHA256SUMS (the
# trust-anchor pattern: a drifted byte is a pin mismatch, named).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.55"           # v2.8.55 is the host-gated lazy wire
                               # (tebako#853): the fetch planner refuses to
                               # seed a boot tier that cannot read a seeded
                               # entry (windows takes the loud eager
                               # fallback), and the payload edge seals a
                               # lazy runtime before reading its manifest.
                               # It rides v2.8.54's transport window
                               # (tebako#851 — the fix lives in the RUNTIME's
                               # preload, so the runtimes are repinned with
                               # it), v2.8.53's dual-layer lazy mount
                               # (tebako#848), and v2.8.52's install-seal +
                               # doctor fixes; the surface itself ships from
                               # v2.8.50
  sha256:
    linux-gnu-x86_64:
      tebako:    "117612ed8913bcaa3bcb83ec936080077a72987ff5e095cac2575f431876ca89"
      tfs:    "c1fee608305b4a7377a76ceb24e7ac313f32343a7898b06544f17b6c72b0b8d9"
      shim:    "f069fd722f718bf6e498953ad2afa10be5270a05425aff1c50fcacdd7aa577e6"
      pkg:    "041a86e5fb8c524e64bcb3f95f9c5c8ae61f0deb439b4e83f69a30d9ea3d61fa"
    linux-gnu-arm64:
      tebako:    "c31df4e8b569a4d428548a9331138f4d2e17b0c2193ab8d28eedce02cfd67e77"
      tfs:    "315fb51898af1d4b4e5a1d5e7a6d362baa773fec26f469af0d890536bed396b4"
      shim:    "339ac16be9a8085b14071fd302004e1aa7902bfe831bb5e7090849ea8f505841"
      pkg:    "8f88a10c92744ac7fbf4fcde2cdd5bb4212b986db2936e2f3d6d343b106b4fd8"
