# Suite recipe for hello-runtimes — one hello-world app payload per
# tebako runtime. This repo is deliberately a SUITE: one repo, one
# release, N payloads (the per-runtime samples share a version line).
# The one-repo-per-package convention bends here by design — this is the
# reference the docs walk through.
name: hello-runtimes
version: "1.0.7"               # every payload in the suite versions together

# The pinned tebako toolchain (tfs mkimage + tebako check/publish),
# digest-pinned per platform against the release's own SHA256SUMS (the
# trust-anchor pattern: a drifted byte is a pin mismatch, named).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.52"           # v2.8.52 carries the install-seal (tebako#843)
                               # and doctor (tebako#846) fixes on the lazy
                               # runtime layout; the surface itself ships
                               # from v2.8.50 (spec 07 §10) and the
                               # engine-surface job rides it
  sha256:
    linux-gnu-x86_64:
      tebako:    "ac313421c542082ffe2a7a40ea97526d5532738c7d608bd7beb941c065a67597"
      tfs:    "7c53646a70af1c7575f2f7c40773ed49472d2888721c1700045bc2eee5cc37a5"
      shim:    "d32038d14affdf64bd90e29d8128959684ee9b2eef0652280671572a49c75efa"
      pkg:    "7dd6d81bd4274be59e1a7e8a548ca432806f34a8ac7c7023850a70a55852b35c"
