      tfs:    "69838a11b86a306614a3ae9ce03165c2350ad937e2346b85cfba1cc246efea69"
      shim:    "3c249c202a47e15525638f06be0996ecaa427608c199c2dca23b6e3a5c107a15"
      pkg:    "10420b6e31599b2553a82d76d8a4decbdef9d41c393d292933b09a266024ceaf"
    macos-x86_64:
      tebako:    "9d5f4a915ed5cffa6f2a037ae39b251a5b35327b63a13b1edb57543a985b6d19"
      tfs:    "291dc55479505b5dd17d6e3b11f4a4f23e5eb1a4d050906d4b3910508037b9d8"
