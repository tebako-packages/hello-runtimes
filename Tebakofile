# Suite recipe for hello-runtimes — one hello-world app payload per
# tebako runtime. This repo is deliberately a SUITE: one repo, one
# release, N payloads (the per-runtime samples share a version line).
# The one-repo-per-package convention bends here by design — this is the
# reference the docs walk through.
name: hello-runtimes
version: "1.0.1"               # every payload in the suite versions together

# The pinned tebako toolchain (tfs mkimage + tebako check/publish),
# digest-pinned per platform against the release's own SHA256SUMS (the
# trust-anchor pattern: a drifted byte is a pin mismatch, named).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.2"
  sha256:
    linux-gnu-x86_64:
      tebako: "90eece5ee2f330e776a194ba3e254e1cb0147ae50b1f5cdbeea9828ce3e8bcd0"
      tfs:    "4d6dc1d2b74d1f688644ee8af61c90ca13560f0b5e9463023a5fa075f80c877c"
      shim:   "3a643a94b18b2427ea3e55602a82709e34acf07e736989045cf91b2c16e5fd27"
    linux-gnu-arm64:
      tebako: "fdf838597649ed066ca7c48ca36f97e104030a8cb78823b0901f8bae236b66e7"
      tfs:    "8823a46723f3e123264ffdee755276a0c4271fcef036c287224dcd5820dd7156"
      shim:   "f0d2bcfdf675514df8faa28d4ca930cf131a120809b533a4d0b4e86597634dd6"
    macos-x86_64:
      tebako: "11843b58587a0566dfa66904bd06f557a11ee18c116845a6d426482b7e976c7c"
      tfs:    "43402ff74b9c8484410f23349f94d9703b26b6f22677abc44439bf3aa969bb64"
      shim:   "0112a75c84e8ea325cb6bf8cb915ad55301bdef12c344e969cb5ae2fe226524a"
    macos-arm64:
      tebako: "83bd46fa921a0c59cfb56287fb317812b61e77237cd733546c0c833229190399"
      tfs:    "99dff652b3d391e5164ba67575cc4c3b9fdf4b8ac04ccfba81978b75ca3cf9e0"
      shim:   "252bc533c4b724dd4a80eb1e1b804b20a941b62d6545d3eaa4cbe5a96d52adc8"
    windows-ucrt64:
      tebako: "d05692ad56a3552381ac3339ac53e15f9dd52eaaa97215500c7fdcdcb72eff56"
      tfs:    "e96bc9b47bdd992af1c032d84894eb8a3dcd42e43f42f9cd52a7eee11fe5be4a"
      shim:   "0d159564be9e6c9a81f18bc02327e3de1b7377dd03c2e93b552b189b8c90c666"

# The apps. Each names its runtime FACTORY + the exact runtime line(s)
# the legs stage (release channel only — run-artifacts stay a factory
# debug channel). hello-ruby stages BOTH published ruby lines: one
# payload, a range edge, two runtimes — the version-choice story.
apps:
  hello-ruby:
    engine: ruby
    factory: tamatebako/tebako-runtime-ruby
    runtimes:
      - {version: "4.0.6",  tebako: "0.16.23", release: "v0.16.23"}
      - {version: "3.3.12", tebako: "0.16.23", release: "v0.16.23"}
    platforms: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-macos, aarch64-macos, x86_64-windows-ucrt]
  hello-python:
    engine: python
    factory: tamatebako/tebako-runtime-python
    runtimes:
      - {version: "3.14.7", tebako: "0.2.0", release: "v0.2.0"}
    # The windows-ucrt leg waits on the factory: the windows python
    # runtime has no mount tier yet (its fs TU answers any mount with a
    # named exit 69), so a windows payload cannot execute on its own
    # platform until then.
    platforms: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-macos, aarch64-macos]
  hello-java:
    engine: java
    factory: tamatebako/tebako-runtime-openjdk
    runtimes:
      - {version: "21.0.12", tebako: "2.7.0", release: "v2.7.0"}
    # The openjdk factory ships three platforms today (linux-gnu-x86_64,
    # macos-arm64, windows-ucrt64) — aarch64-linux and x86_64-macos legs
    # join when the factory ships those packages.
    platforms: [x86_64-linux-gnu, aarch64-macos, x86_64-windows-ucrt]
  hello-flavor-acme:
    # The reference EXTENSION slice (spec 03 §2.8): toolkit-kind content
    # that augments hello-ruby (the reverse edge is in its manifest, not
    # here). A slice stages no runtime legs of its own — the language
    # edge is satisfied by the BASE's resolved runtime at dispatch — so
    # `runtimes` is empty and the leg loop smokes nothing; the slice's
    # proof is the dispatch-time acceptance (the base's output gains the
    # flavor's line), which joins with the toolchain release carrying
    # the slice scan.
    engine: ruby
    factory: tamatebako/tebako-runtime-ruby
    runtimes: []
    platforms: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-macos, aarch64-macos, x86_64-windows-ucrt]

# The leg topology (host runner per triplet). Every leg is runner-native;
# only the java leg compiles — the app's own source, with the runner's
# hosted JDK (audience law 3), never anything tebako-side.
ci:
  hosts:
    x86_64-linux-gnu: "ubuntu-22.04"
    aarch64-linux-gnu: "ubuntu-22.04-arm"
    x86_64-macos: "macos-15-intel"   # macos-15 itself is arm64; Intel legs need the -intel label
    aarch64-macos: "macos-latest"
    x86_64-windows-ucrt: "windows-2022"

# Signing (spec 09 §9): on tag pushes the publish step signs every
# payload image with the CI signing subkey of the tamatebako root (org
# secret TEBAKO_CI_SIGNING_KEY); the registry pins the PRIMARY keyid.
signing:
  keyid: "efc3c250f7862a48"
