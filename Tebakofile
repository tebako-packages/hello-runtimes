# The apps. Each names its runtime FACTORY + the exact runtime line(s)
# the legs stage (release channel only — run-artifacts stay a factory
# debug channel). hello-ruby stages BOTH published ruby lines: one
# payload, a range edge, two runtimes — the version-choice story.
apps:
  hello-ruby:
    engine: ruby
    factory: tamatebako/tebako-runtime-ruby
    runtimes:
      - {version: "4.0.7",  tebako: "0.16.32", release: "v0.16.32-ruby4.0"}
      - {version: "3.3.12", tebako: "0.16.32", release: "v0.16.32-ruby3.3"}
    platforms: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-macos, aarch64-macos, x86_64-windows-ucrt]
  hello-python:
    engine: python
    factory: tamatebako/tebako-runtime-python
    runtimes:
      - {version: "3.14.7", tebako: "0.3.3", release: "v0.3.3"}
    # The windows-ucrt leg still waits on the payload mount tier: the
    # pair is now self-contained (v0.3.2's static gettext) and the engine
    # surface exercises its boot under the hostile PATH, but a windows
    # PAYLOAD run has not been proven — the platform joins this app's
    # matrix when that acceptance exists.
    platforms: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-macos, aarch64-macos]
  hello-java:
    engine: java
    factory: tamatebako/tebako-runtime-openjdk
    runtimes:
      - {version: "21.0.12", tebako: "2.7.0", release: "v2.7.0"}
    # The openjdk factory ships three platforms today (linux-gnu-x86_64,
    # macos-arm64, windows-ucrt64) — aarch64-linux and x86_64-macos legs
    # join when the factory ships those packages.
    platforms: [x86_64-linux-gnu, aarch64-macos, x86_64-windows-ucrt]
  hello-jruby:
    engine: ruby
    factory: tamatebako/tebako-runtime-jruby
    runtimes:
      # The jruby wrapper composes onto its declared OWNER at dispatch
      # (the runtime-on-runtime composition): the legs stage the owner
      # line beside the depending one so the smoke's owner-side handoff
      # resolves without a network.
      - version: "10.1.1.0"
        tebako: "2.5.0"
        release: "v2.5.0"
        owner: {engine: java, implementation: temurin, version: "21.0.12", tebako: "2.7.0", release: "v2.7.0", factory: tamatebako/tebako-runtime-openjdk}
    # The jruby factory ships linux-gnu-x86_64 + macos-arm64 today (a
    # universal env image; the wrapper exe per platform) — further legs
    # join when the factory ships them.
    platforms: [x86_64-linux-gnu, aarch64-macos]
  hello-truffleruby:
    engine: ruby
    factory: tamatebako/tebako-runtime-truffleruby
    runtimes:
      # Same composition as jruby, on the graalvm owner flavor.
      - version: "34.0.1"
        tebako: "2.5.0"
        release: "v2.5.0"
        owner: {engine: java, implementation: graalvm, version: "25.0.4.1", tebako: "2.7.0", release: "v2.7.0", factory: tamatebako/tebako-runtime-openjdk}
    # The truffleruby factory ships linux-gnu-x86_64 + macos-arm64 (jvm
    # mode) today.
    platforms: [x86_64-linux-gnu, aarch64-macos]
  hello-node:
    # The first wrapper-exe JS engine arm: the runtime pair dispatches
    # node 24 LTS; the entry is plain JS, copied verbatim — nothing
    # compiles.
    engine: node
    factory: tamatebako/tebako-runtime-node
    runtimes:
      # The 2.8.47 line: the factory pairs embed the launcher whose
      # preload boot bridges the entry token (tebako#831's fix) — the
      # POSIX legs' PATH-trap acceptance rides exactly this line.
      - {version: "24.22.0", tebako: "2.8.48", release: "v2.8.48"}
    platforms: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-macos, aarch64-macos, x86_64-windows-ucrt]
  hello-bun:
    # The TS-native headline: the entry IS TypeScript (/app/cli.ts) — bun
    # transpiles it in-process at dispatch, no compile step anywhere.
    engine: bun
    factory: tamatebako/tebako-runtime-bun
    runtimes:
      - {version: "1.4.3", tebako: "2.8.47", release: "v2.8.47"}
    platforms: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-macos, aarch64-macos, x86_64-windows-ucrt]
  hello-flavor-acme:
    # The reference EXTENSION slice (spec 03 §2.8): toolkit-kind content
    # that augments hello-ruby (the reverse edge is in its manifest, not
    # here). A slice stages no runtime legs of its own — the language
    # edge is satisfied by the BASE's resolved runtime at dispatch — so
    # `runtimes` is empty and the leg loop smokes nothing; the slice's
    # proof is the dispatch-time acceptance (the base's output gains the
    # flavor's line), which joins with the toolchain release carrying
    # the slice scan.
    engine: ruby
    factory: tamatebako/tebako-runtime-ruby
    runtimes: []
    platforms: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-macos, aarch64-macos, x86_64-windows-ucrt]

# The installer samples — OS-native containers (MSI + pkg) for one app of
# the suite, in BOTH compositions (the client-product reference shape):
#   lean  the tebako toolset + an install-time seed that registers this
#         suite's registry, installs the payload, and WARMS its runtime
#         (the seed dispatches the shim once at install) — network at
#         install time, none at first run. The runtime is prefetched at
#         install time, never lazily at first run.
#   fat   a self-contained press (bootstrap + runtime exe + env image +
#         payload in ONE exe, riding the app's FIRST listed runtime
#         line) — zero network at install or run (the airgap shape).
# Both bind the product repo's parameterized installer templates with
# THIS org's identity — the same files a client CI binds with its own.
installers:
  app: hello-ruby
  registry: "tfs:github:tebako-packages/hello-runtimes"
  # The install-time seed's warm set (must stay a subset of the payload
  # set): print-and-exit entrypoints only — the seed runs no timeout.
  warm: [hello-ruby]
  min_macos: "12.0"
  manufacturer: tebako-packages        # the MSI registry key root / pkg publisher line
  compositions:
    lean:
      product_name: hello-ruby
      org_id: org.tebako-packages    # the pkg identifier prefix (reverse-DNS, one per publisher)
      install_root: /opt/hello-ruby
      # The MSI UpgradeCode pairs upgrades for this product line —
      # LOCKED FOREVER (minted 2026-09-17). A fork MUST mint its own.
      msi_upgrade_code: "0D82909B-C797-4948-B680-D61D38DDDA81"
    fat:
      product_name: hello-ruby-fat
      org_id: org.tebako-packages
      install_root: /opt/hello-ruby-fat
      msi_upgrade_code: "DC542BA7-498F-43FC-A6F5-5578953B1E13"   # LOCKED 2026-09-17
  # The installer source set, fetched at CI time and digest-verified file
  # by file (never forked): the parameterized templates + the fail-closed
  # signing gates from the pinned tebako release tag (tools.release), and
  # the fat exe's codesign profile FLOWED from the ruby runtime factory
  # (the single owner of the runtime signing profile) at the pinned ruby
  # runtime release. A pin mismatch is a named failure, never a skip.
  sources:
    - repo: tamatebako/tebako
      ref: tools        # resolves to the tools.release tag
      files:
        templates/installers/windows/tebako.wxs: "b2f71eac8f4f1422f7c33ef0ade6a7f0c4ca489ec1c01a7d26fc0b267d78e366"
        templates/installers/macos/distribution.xml: "ef46ce5c9c560e38892ff1eecf48541d89648a891f61d6d11a7b02282801930a"
        templates/installers/macos/scripts/postinstall: "ba0ac849a5ccd699f28a41e918917721c002f4612c00ef4926244b032658c4f8"
        ci/windows-sign-gate.sh: "1aaaa600558181d101c25db2de72d4094ff09da4da5a72d44ff0c1097913ad79"
        ci/macos-sign-setup.sh: "d92ca2e25bf0c540fdc82adc873e991d829a1058bbe82e3405fe2789b9301989"
        ci/macos-sign-setup-installer.sh: "38aaaf13410327764e3dadaa68d77ca541fd6e2a615c8823d7780bdcb926eb45"
    - repo: tamatebako/tebako-runtime-ruby
      ref: runtime      # resolves to the app's first runtime line's release tag
      files:
        ci/runtime.entitlements: "fd21715f3bbda901566cd2368c989eaf326cf0a4b6aaf58bacf0bcc7383bfe24"

# The leg topology (host runner per triplet). Every leg is runner-native;
# only the java leg compiles — the app's own source, with the runner's
# hosted JDK (audience law 3), never anything tebako-side.
ci:
  hosts:
    x86_64-linux-gnu: "ubuntu-22.04"
    aarch64-linux-gnu: "ubuntu-22.04-arm"
    x86_64-macos: "macos-15-intel"   # macos-15 itself is arm64; Intel legs need the -intel label
    aarch64-macos: "macos-latest"
    x86_64-windows-ucrt: "windows-2022"

# Signing (spec 09 §9): on tag pushes the publish step signs every
# payload image with the CI signing subkey of the tamatebako root (org
# secret TEBAKO_CI_SIGNING_KEY); the registry pins the PRIMARY keyid.
signing:
  keyid: "efc3c250f7862a48"
