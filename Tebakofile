    linux-gnu-x86_64:
      tebako:    "9618711295d785d7dfb32c00a74a40db32c0846eeaae4f18ffbaeab662e167bd"
      tfs:    "3d99d9429fc156962bcd848747531a9b714947e28640fd1526388cc0d1eaca40"
      shim:    "88afbd4d35ad74474c64d07a5dd4f4fb951c7225efa1636b12c05f126c838949"
