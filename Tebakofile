# Suite recipe for hello-runtimes — one hello-world app payload per
# tebako runtime. This repo is deliberately a SUITE: one repo, one
# release, N payloads (the per-runtime samples share a version line).
# The one-repo-per-package convention bends here by design — this is the
# reference the docs walk through.
name: hello-runtimes
version: "1.0.10"               # every payload in the suite versions together

# The pinned tebako toolchain (tfs mkimage + tebako check/publish),
# digest-pinned per platform against the release's own SHA256SUMS (the
# trust-anchor pattern: a drifted byte is a pin mismatch, named).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.53"           # v2.8.53 carries the lazy mount at both TFS
                               # layers (tebako#848): the preload shim
                               # state-detects a LAZY_SEEDING env image, so a
                               # fresh lazy line serves the interpreter's
                               # stdlib. v2.8.52 carried the install-seal
                               # (tebako#843) and doctor (tebako#846) fixes;
                               # the surface itself ships from v2.8.50
  sha256:
    linux-gnu-x86_64:
      tebako:    "e8cdd2ee2407330de788722e1f434a57c365a2395ccb5f33df81fbf55330508f"
      tfs:    "a9ed72f257af54ee6845db9fd599948e1d6da1717f236609d094af675af919a6"
      shim:    "fcb97f881b5b59b87be4fd79fd5f2996b230ba82b51adfca5a56eaa3800808be"
      pkg:    "c0bc66a3a5410715e5984c9e70aa7920eefcabcf24ba029a96b3c540e4c9c364"
    linux-gnu-arm64:
