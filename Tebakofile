      pkg:    "43dd8c623f21e2aede955fbf6bb6c72804c42e007b0433f8791b4ebe4dd68bdc"
    macos-x86_64:
      tebako:    "8e984def0df8afb5104b02980bb6861dbb89cf448a70a664c38736333ba7da18"
      tfs:    "73f5de494913b5df10535808db850af727cd552d125478eed6eb648e5f797cf4"
      shim:    "b7e6e8522d954dc7712507169222a7dc9c119d52d2114505c7d50ad09ceb8970"
      pkg:    "371580229ba6d4ad65c29a7e3dbe00aff3af29c09a63541bc62ed6e0c7331453"
    macos-arm64:
      tebako:    "ec709c86a10de76fa33f458c869142c23d71e2c2aaf0aecfa22c8582ab4db5d6"
