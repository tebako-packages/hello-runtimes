<Project Sdk="Microsoft.NET.Sdk">

  <!-- hello-dotnet — the suite's compiled-dotnet shape (the java arm's
       jar precedent): framework-dependent deployment riding the dotnet
       runtime's shared framework (the pair's identity is the SDK band;
       the app rolls forward onto the carried Microsoft.NETCore.App).
       The leg compiles with the runner's hosted SDK (actions/setup-dotnet,
       the workflow's dotnet-gated step — the setup-java idiom). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>hello</AssemblyName>
  </PropertyGroup>

</Project>
