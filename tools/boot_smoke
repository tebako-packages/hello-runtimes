#!/usr/bin/env bash
# tools/boot_smoke <image.tfs> — the release gate: assert the entrypoint
# exists in the image and the payload runs green through its staged
# runtime.
#
# Legs:
#   1. in-process image assertions (the tfs CLI): the entrypoint + the
#      embedded manifest.
#   2. extract round-trip.
#   3. the spec-26 press-time gate: `tebako check <image> --runtime <exe>
#      --runtime-image <env.tfs>` runs the manifest's checks: block.
#   4. the manual spec-17 dispatch smoke: the payload mounted bare at
#      "/", TEBAKO_RUNTIME_IMAGE for the env image, --tebako-entry — the
#      greeting must come back naming the engine.
#
# Env: TFS, TEBAKO, RUNTIME, RUNTIME_IMAGE (tools/build writes the last
# two into out/<triplet>/runtime.env), APP (the sample app name).
set -euo pipefail

IMG="${1:?usage: tools/boot_smoke <image.tfs>}"
TFS="${TFS:-tfs}"
TEBAKO="${TEBAKO:-tebako}"
APP="${APP:?set APP (pins.rb --env)}"
RUNTIME="${RUNTIME:?set RUNTIME to the staged runtime exe (runtime.env)}"
RUNTIME_IMAGE="${RUNTIME_IMAGE:?set RUNTIME_IMAGE to the runtime env .tfs}"

case "$APP" in
  hello-ruby)   ENTRY=/app/hello.rb;   ENGINE=ruby ;;
  hello-python) ENTRY=/app/hello.py;   ENGINE=python ;;
  hello-java)   ENTRY=/app/Hello.java; ENGINE=java ;;
  *) echo "boot_smoke: unknown APP: $APP" >&2; exit 1 ;;
esac

echo "== entrypoint assertions (in-process mount via the tfs CLI)"
"$TFS" stat "$IMG" "$ENTRY" | grep -q File
"$TFS" stat "$IMG" /__tpkg__/manifest.yaml | grep -q File
echo "   $ENTRY + manifest: present"

echo "== extract round-trip"
X="$(mktemp -d)"
"$TFS" extract -d "$X" "$IMG"
[ -f "$X${ENTRY}" ] || { echo "extracted entrypoint missing: $X$ENTRY"; exit 1; }

echo "== spec 26 payload checks (tebako check, the press-time moment)"
"$TEBAKO" check "$IMG" --runtime "$RUNTIME" --runtime-image "$RUNTIME_IMAGE"

echo "== manual spec-17 dispatch smoke"
out="$(TEBAKO_RUNTIME_IMAGE="$RUNTIME_IMAGE" \
  "$RUNTIME" "--tebako-image=$IMG:-:/" "--tebako-entry=$ENTRY")"
echo "   $out"
echo "$out" | grep -q "Hello from tebako ($ENGINE" \
  || { echo "boot_smoke: the greeting did not name $ENGINE: $out"; exit 1; }

echo "BOOT-SMOKE-OK"
