#!/usr/bin/env bash
# tools/engine_surface — the runtime-own command surface acceptance leg
# (spec 07 §10, shipped in tebako v2.8.50): one leg per platform exercises
# the WHOLE engine set sequentially — a failure's section header names the
# engine.
#
# Covered per leg (every assertion is observable output or a named exit
# code, never a mock):
#   * `tebako run <engine>` (bare → the runtime's default entry) and
#     `tebako run <engine>:<command>` (a declared runtime entrypoint),
#     resolved against the leg's CONFIGURED factory registries (no
#     default registry exists — the config below is the surface's whole
#     point), the runtime pair downloaded + verified + cached on first
#     use.
#   * The named errors: `tebako run nosuchengine` → 69 (no configured
#     registry carries the engine — every consulted channel named);
#     `tebako run java:nosuch` → 65 (the runtime's env image declares no
#     such entrypoint — the declared set listed).
#   * The skip gates: `tebako run jruby|truffleruby` → 69 TODAY — their
#     factory registries carry no `engine:` key (spec 04 §2 MINOR 1's
#     discovery key; a kind: runtime entry without it is invisible to
#     engine resolution), and their runtime-on-runtime composition rides
#     the payload dispatch path by design (the owner compose is not the
#     runtime-own wire). When a factory renders the engine key this arm
#     flips red ON PURPOSE — replace the gate with the real dispatch arm
#     then (never silence it).
#   * The shim surface: `tebako install <engine>` (bare → the default
#     entry's shim) and `tebako install java:keytool` / `python:pip` (the
#     command form), dispatch through the registered shims, `tebako shim
#     list` answering the runtime-own class (text + JSON), `tebako doctor`
#     reporting the runtime-own rows ok.
#
# Per-engine command forms (verified against the published env images'
# declared spawn surfaces, 2026-10-21):
#   ruby    bare + gem — the v0.17.2 images declare the gem toolchain
#           (fifteen commands, read from the image's manifest); the bare
#           form remains the interpreter.
#   python  bare + pip — the v0.3.1 images declare pip/pip3; the bare arm
#           uses a REAL stdlib import because `--version` exits before
#           any import and would not see a lazy mount that serves no
#           stdlib (tamatebako/tebako#848). The windows pair is
#           self-contained from v0.3.2 (static gettext,
#           tamatebako/tebako-runtime-python#55), so the hostile-PATH
#           boot is now a positive arm on every platform.
#   java    bare + keytool, version-pinned to the temurin line via the
#           version chain's env link (TEBAKO_JAVA_VERSION, exported
#           leg-wide below): the unpinned pick is the newest version
#           published for the platform, which is the graalvm flavor
#           (25.x > 21.x) — a ~440 MB image where temurin is ~75 MB, and
#           the declared-set text would fork per flavor. The pin value
#           is the openjdk factory's published temurin version (its
#           registry is the owner; old rows are append-only, so the pin
#           keeps resolving). The pin rides the env link rather than
#           config `defaults:` because doctor's routing health (spec 07
#           §3) scans PAYLOAD claims only — a bare engine name in
#           `defaults:` reads as a dangling pin in a runtime-own-only
#           store (the env link is per-invocation; doctor does not
#           inspect it).
#   node    bare + node:node — the ONLY entrypoint that is a native
#           binary. npm/npx/corepack are declared on POSIX but are
#           env-shebang JS launchers: the spawn path materializes the
#           single entry and its `#!/usr/bin/env node` resolves the HOST
#           node (the PATH trap below catches exactly this class), and
#           the windows declared set drops them (the recipe's
#           entrypoints_windows_drop). node:node is the cross-platform
#           named form.
#   bun     bare + bunx (declared on every platform; bunx is the same
#           static binary re-entrant under its alias).
#
# Env (the workflow supplies): TEBAKO (the pinned CLI path), TRIPLET (the
# leg's triplet, messages only). The registries + the java pin are derived
# here from the Tebakofile via pins.rb — never a second hand-written copy.
set -euo pipefail

FEEDSTOCK="$(cd "$(dirname "$0")/.." && pwd)"
cd "$FEEDSTOCK"

TEBAKO="${TEBAKO:-$FEEDSTOCK/.tools/tebako}"
# The windows tool assets carry the .exe suffix — resolve it where present.
[ -e "$TEBAKO" ] || [ ! -e "$TEBAKO.exe" ] || TEBAKO="$TEBAKO.exe"
TRIPLET="${TRIPLET:-unknown}"

# TEBAKO_HOME: a scratch store inside the workspace (NEVER the runner's
# real ~/.tebako). Native windows tools cannot read Git Bash's POSIX
# spellings — the exported value goes windows-form where cygpath exists;
# bash-side path joins keep the local form.
HOME_LOCAL="$FEEDSTOCK/out/engine-home"
rm -rf "$HOME_LOCAL"
mkdir -p "$HOME_LOCAL"
if command -v cygpath >/dev/null 2>&1; then
  export TEBAKO_HOME="$(cygpath -m "$HOME_LOCAL")"
else
  export TEBAKO_HOME="$HOME_LOCAL"
fi

say()  { printf '\n== %s\n' "$*"; }
die()  { echo "engine-surface: $*" >&2; exit 1; }

# run_ok <ere> <args…>: the dispatch must exit 0, its combined output
# must match the identity pattern (ERE), and the PATH-trap canary must
# never appear (a host-interpreter leak prints PATH-LEAK).
run_ok() {
  local want="$1"; shift
  local out rc
  set +e
  out="$(PATH="$TRAP_PATH" "$TEBAKO" "$@" 2>&1)"
  rc=$?
  set -e
  printf '%s\n' "$out"
  [ "$rc" -eq 0 ] || die "tebako $* — exit $rc (want 0)"
  grep -qE -- "$want" <<<"$out" || die "tebako $* — output misses /$want/: $out"
  ! grep -q "PATH-LEAK" <<<"$out" || die "tebako $* — a host PATH interpreter answered (PATH-LEAK)"
}

# run_rc <want-rc> <fixed-string> <args…>: a named-error dispatch — exit
# code and message shape are BOTH the contract (the fragment is a FIXED
# string, grep -F).
run_rc() {
  local wantrc="$1" want="$2"; shift 2
  local out rc
  set +e
  out="$(PATH="$TRAP_PATH" "$TEBAKO" "$@" 2>&1)"
  rc=$?
  set -e
  printf '%s\n' "$out"
  [ "$rc" -eq "$wantrc" ] || die "tebako $* — exit $rc (want $wantrc)"
  grep -qF -- "$want" <<<"$out" || die "tebako $* — output misses «$want»: $out"
}

# run_wire_ok <ere> <args…>: run_ok PLUS the wire assertion — the first
# fetch's transcript must NAME the wire it chose. Three spellings are
# honest, and each is a different layer's answer: the lazy seed (a boot
# tier that reads a seeded entry, on a release serving the wire), the
# host-tier fallback (a tier that cannot — windows), and the
# release-side fallback (a factory release that ships no blksum sidecar
# yet). Silence or any fourth shape is the failure: a fetch must always
# say which wire it took.
run_wire_ok() {
  local want="$1"; shift
  local out rc
  set +e
  out="$(PATH="$TRAP_PATH" "$TEBAKO" "$@" 2>&1)"
  rc=$?
  set -e
  printf '%s\n' "$out"
  [ "$rc" -eq 0 ] || die "tebako $* — exit $rc (want 0)"
  grep -qE -- "$want" <<<"$out" || die "tebako $* — output misses /$want/: $out"
  ! grep -q "PATH-LEAK" <<<"$out" || die "tebako $* — a host PATH interpreter answered (PATH-LEAK)"
  case "$out" in
    *"lazy: seeding on demand"*) ;;
    *"cannot install lazily"*) ;;
    *"does not serve the lazy wire"*) ;;
    *) die "tebako $* — the first fetch named no wire: $out" ;;
  esac
}

# The hostile-PATH trap (the suite's boot_smoke pattern): any dispatch
# that resolves its interpreter through the host PATH must fail LOUDLY —
# a leak runs a fake, prints the canary, and the assertion dies. Scoped
# per invocation, never exported (the leg's own tooling rides the real
# PATH).
TRAP_DIR="$(mktemp -d)"
trap 'rm -rf "$TRAP_DIR"' EXIT
for name in ruby python python3 node npm npx bun bunx java keytool gem jruby truffleruby; do
  printf '#!/bin/sh\necho "PATH-LEAK: %s executed from the host PATH" >&2\nexit 42\n' "$name" > "$TRAP_DIR/$name"
  chmod +x "$TRAP_DIR/$name"
done
TRAP_PATH="$TRAP_DIR:/usr/bin:/bin"

say "store config: the seven factory registries; the temurin pin rides the env link"
# The registries list FLOWS from the Tebakofile's apps.*.factory set
# (pins.rb --engine-registries). No default registry exists by design —
# engine resolution reads exactly these. The java pin is the version
# chain's first link (the env var — a bare version, never
# payload@version): the temurin flavor line (see the header).
{
  echo "registries:"
  ruby tools/pins.rb --engine-registries | sed 's/^/  - /'
} > "$HOME_LOCAL/config.yaml"
cat "$HOME_LOCAL/config.yaml"
export TEBAKO_JAVA_VERSION="21.0.12"

# The lazy wire is the default (spec 39's flip); the arm states it
# EXPLICITLY so a future default change cannot silently un-assert the
# wire, and asserts the transcript per engine below.
export TEBAKO_RUNTIME_LAZY=1

say "engine: ruby (bare form — the interpreter, and the wire it chose)"
run_wire_ok '^ruby [0-9]' run ruby --version
say "engine: ruby (bare + gem — the v0.17.2 spawn surface)"
run_ok '^[0-9]+\.' run ruby:gem --version

say "warm: the lazy wire — the first fetch seeds on demand (tebako#851 closed)"
# The first fetch of each engine IS the acceptance of the wire the HOST
# can boot: a POSIX tier seeds the env image on demand and serves the
# interpreter's stdlib through the seeded mount; a tier that extracts a
# host tree from the image file (windows) takes the LOUD eager fallback
# by design (tebako#853) — never a refusal, never a hang. The transcript
# line the fetch prints is asserted per engine below.

say "engine: python (bare form — a REAL stdlib import, not --version)"
# --version exits before any stdlib import and is therefore a vacuous
# probe: it passed while a LAZY_SEEDING env image served no stdlib at all
# (tamatebako/tebako#848). The import is the acceptance — and on a POSIX
# tier it is served through the SEEDED mount (the wire assertion).
run_wire_ok '^encodings$' run python -c "import encodings; print(encodings.__name__)"
# The v0.3.1+ spawn surface: both declared names answer, over the same
# store (the second name is the factory's own alias, not a guess).
run_ok '^pip [0-9]' run python:pip --version
run_ok '^pip [0-9]' run python:pip3 --version
# An undeclared command is a NAMED refusal (exit 65) that lists what the
# image does declare — never a silent fallback to a host interpreter.
run_rc 65 "declares no runtime entrypoint of that name (declared: pip, pip3)" \
  run python:nonexistent --version

say "engine: python (the hostile-PATH boot — the pair is self-contained)"
# tamatebako/tebako-runtime-python#55: the windows pair used to need a
# host mingw/msys directory on PATH (libpython3.14.dll imports
# libintl-8.dll). v0.3.2 static-binds the gettext closure, so the boot
# must now succeed with PATH scrubbed to the trap — on EVERY platform
# (the trap is the arm's standing hostile environment).
set +e
out_py="$(PATH="$TRAP_PATH" "$TEBAKO" run python -c "import encodings; print(encodings.__name__)" 2>&1)"
rc_py=$?
set -e
printf '%s\n' "$out_py"
[ "$rc_py" -eq 0 ] || die "the python boot under the hostile PATH failed (exit $rc_py): the pair is not self-contained (tamatebako/tebako-runtime-python#55)"
printf '%s' "$out_py" | grep -q '^encodings$' || die "the hostile-PATH python boot printed no encodings line: $out_py"

say "engine: java (bare + keytool; the temurin pin)"
run_ok 'openjdk version "21\.0\.12"' run java -version
run_ok 'Key and Certificate Management Tool' run java:keytool

say "engine: node (bare + the node:node named form)"
run_ok '^v[0-9]' run node --version
run_ok '^v[0-9]' run node:node --version

say "engine: bun (bare + bunx)"
run_ok '^[0-9]+\.[0-9]+\.[0-9]+' run bun --version
run_ok '^[0-9]+\.[0-9]+\.[0-9]+' run bun:bunx --version

say "named errors: the no-such-engine and undeclared-entrypoint shapes"
run_rc 69 'none lists a `kind: runtime` entry for engine "nosuchengine"' run nosuchengine
run_rc 65 "--tebako-entry 'nosuch': the env image declares no runtime entrypoint of that name (declared: java, jfr, jrunscript, jwebserver, keytool, rmiregistry)" run java:nosuch

say "skip gates: jruby + truffleruby (registry carries no engine: key)"
run_rc 69 'engine "jruby"' run jruby
run_rc 69 'engine "truffleruby"' run truffleruby

say "the shim surface: install (bare + command forms), dispatch, list, doctor"
# The dispatcher resolves sibling-wise: tebako-shim sits beside the CLI
# (the fetch step placed it there). Bare form → the default entry's name
# (ruby, node); the command form → the named entry (keytool).
"$TEBAKO" install ruby
"$TEBAKO" install node
"$TEBAKO" install java:keytool
# The python surface's command form (the factory's declared pip entry): the
# same runtime-own class as keytool, on a runtime whose default entry is
# the interpreter itself.
"$TEBAKO" install python:pip

shim_file() { local p="$HOME_LOCAL/shims/$1"; [ -e "$p" ] || p="$p.exe"; [ -e "$p" ] || die "shim missing: $1"; printf '%s' "$p"; }
run_shim_ok() {
  local want="$1" name="$2"; shift 2
  local out rc
  set +e
  out="$(PATH="$TRAP_PATH" "$(shim_file "$name")" "$@" 2>&1)"
  rc=$?
  set -e
  printf '%s\n' "$out"
  [ "$rc" -eq 0 ] || die "shim $name $* — exit $rc (want 0)"
  grep -qE -- "$want" <<<"$out" || die "shim $name $* — output misses /$want/: $out"
  ! grep -q "PATH-LEAK" <<<"$out" || die "shim $name $* — a host PATH interpreter answered (PATH-LEAK)"
}
run_shim_ok '^ruby [0-9]' ruby --version
run_shim_ok '^v[0-9]' node --version
run_shim_ok 'Key and Certificate Management Tool' keytool
run_shim_ok '^pip [0-9]' pip --version

list_out="$("$TEBAKO" shim list)"
printf '%s\n' "$list_out"
for row in 'runtime-own commands:' 'command ruby (engine ruby):' 'command node (engine node):' 'command keytool (engine java):' 'command pip (engine python):'; do
  grep -qF "$row" <<<"$list_out" || die "shim list misses «$row»"
done
[ "$(grep -c '\[runtime-own\]' <<<"$list_out")" -eq 4 ] || die "shim list: want 4 [runtime-own] rows: $list_out"
# The machine form answers the same class (provider_kind + engine). The
# CLI's version banner precedes the document on stdout — the parse starts
# at the first '{'. The document and the CLI's status are captured
# explicitly and always printed, so a CLI failure or a broken row is a
# named error in the log, never a silent exit under `set -e`.
set +e
json_out="$("$TEBAKO" shim list --json 2>&1)"
json_rc=$?
set -e
printf '%s\n' "$json_out"
[ "$json_rc" -eq 0 ] || die "tebako shim list --json — exit $json_rc (output above)"
printf '%s\n' "$json_out" | ruby -rjson -e '
  raw = STDIN.read
  doc = JSON.parse(raw[raw.index("{")..])
  own = doc.fetch("commands").select { |c| c["provider_kind"] == "runtime-own" }
  want = { "ruby" => "ruby", "node" => "node", "keytool" => "java", "pip" => "python" }
  got = own.to_h { |c| [c.fetch("name"), c.fetch("engine")] }
  abort("shim list --json: runtime-own rows #{got.inspect} != #{want.inspect}") unless got == want
  abort("shim list --json: rows unresolved: #{own.inspect}") unless own.all? { |c| c["version"].to_s.length > 0 }
' || die "shim list --json: the document does not answer the four resolved runtime-own rows (parser output above)"

# Doctor gates on a QUIET store: the leg is sequential, so the per-entry
# flock files left behind by the installs are provably uncontended — drop
# them (the stale-lock heuristic flags any file older than the 120 s
# flock timeout, and a slow first-engine download would otherwise false
# the verdict), and put the shims dir on PATH (the not-on-PATH finding is
# a shell-integration note, never this leg's subject).
#
# Doctor re-probes every configured registry (the dispatch-cache rows), so
# a transient API failure is a network event, not a store verdict. The
# output is CAPTURED WITH ITS STATUS and always printed: a bare
# `doctor_out="$(…)"` under `set -e` swallows the finding and kills the
# leg with no diagnostics. One retry covers a transient probe; a second
# failure is the named error, with the full output above it.
rm -f "$HOME_LOCAL"/locks/*
export PATH="$HOME_LOCAL/shims:$PATH"
doctor_out=""
doctor_rc=0
for attempt in 1 2; do
  set +e
  doctor_out="$("$TEBAKO" doctor 2>&1)"
  doctor_rc=$?
  set -e
  printf '%s\n' "$doctor_out"
  [ "$doctor_rc" -eq 0 ] && break
  if [ "$attempt" -eq 1 ]; then
    echo "tebako doctor exited $doctor_rc (attempt 1 of 2) — the registry probes are network reads; retrying once in 10 s" >&2
    sleep 10
  fi
done
[ "$doctor_rc" -eq 0 ] || die "tebako doctor — exit $doctor_rc on both attempts (output above)"
for row in 'ok: shim ruby: ok (runtime-own, engine ruby' 'ok: shim node: ok (runtime-own, engine node' 'ok: shim keytool: ok (runtime-own, engine java' 'ok: shim pip: ok (runtime-own, engine python'; do
  grep -qF "$row" <<<"$doctor_out" || die "doctor misses «$row»"
done
grep -q 'tebako doctor: no problems found' <<<"$doctor_out" || die "doctor reports problems: $doctor_out"

say "ENGINE-SURFACE-OK ($TRIPLET)"
